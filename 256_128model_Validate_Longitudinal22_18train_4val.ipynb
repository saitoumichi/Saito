   "source": [
    "# configure unet input shape (concatenation of moving and fixed images)\n",
    "ndim = 3\n",
    "unet_input_features = 2\n",
    "# inshape = (*x_train.shape[1:], unet_input_features)\n",
    "\n",
    "nb_features = [\n",
    "    [32, 64, 64, 64, 64],\n",
    "    [64, 64, 64, 64, 64, 32, 16, 16]\n",
    "]\n"
   ]
